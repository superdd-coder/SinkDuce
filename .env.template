# SinkDuce environment variables
# Copy this file to .env and modify as needed:
#   cp .env.template .env
#
# If you see "port is already allocated" error, change the port below.

# Backend API port (default: 18900)
# 本机入口：Docker 只把它发布到宿主机回环（127.0.0.1），本机浏览器经它静默领取主人钥匙。
API_PORT=18900

# 对外（局域网）入口端口 (default: 18901)
# 其他设备（手机、另一台电脑）经它访问本盒子，需要配对钥匙。
EXTERNAL_PORT=18901

# Frontend dev server port (default: 5173)
UI_PORT=5173

# Optional path for an Office converter in source/server deployments.
# Desktop builds set this automatically to their private bundled runtime.
# SINKDUCE_LIBREOFFICE=/absolute/path/to/soffice

# ── 远程模式（瘦壳）─────────────────────────────────────────
# SINKDUCE_REMOTE_MODE=1 时，容器不启动完整后端（不连 Qdrant、不加载模型），
# 只作为已配对盒子的入口壳：前端界面 + 录音（若桌面 App 连它）+ MCP Hub。
# 没有已配对盒子时会显示「先去配对」引导态。
#
# 这个开关在界面上**只读**：要切换模式，改这里然后重建容器——
#   docker compose up -d --force-recreate app
# （想连 Qdrant 的内存也省掉，可以再手动 `docker compose stop qdrant`）
SINKDUCE_REMOTE_MODE=0
